# ==============================================================================
# Telegram Bot
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here
# Optional: enables webhook mode (random A-Za-z0-9_- string, e.g. `openssl rand -hex 32`).
# Leave unset locally to use polling.
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=https://your-backend.example.com

# Numeric Telegram user IDs that should be Super Admins (comma-separated)
# SUPER_ADMIN_TELEGRAM_IDS=123456789,987654321

PORT=3001

# ==============================================================================
# Production only
# ==============================================================================
# NODE_ENV=production
# JACKPOT_SERVER_SECRET=long_random_string   # REQUIRED in production
# DATABASE_PATH=/var/data/bingo.db           # SQLite on a persistent disk
# REDIS_URL=rediss://default:pass@host:6379  # OR back the database up to Redis (restored on boot)
# REDIS_BACKUP_INTERVAL_SECONDS=10
# REDIS_KEY_PREFIX=bingo:
# TRUST_PROXY=1
# AUTH_RATE_LIMIT_PER_MINUTE=15
# REFERRAL_MIN_DEPOSIT_ETB=100
# REFERRAL_MIN_CARDS=5
# REFERRAL_MAX_REWARDS_PER_DAY=20

# ==============================================================================
# Development modes
# ==============================================================================

# --- MODE A: LOCAL DEVELOPMENT ---
# FRONTEND_URL=http://localhost:5173
# WEBAPP_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# VITE_BACKEND_URL=http://localhost:3001

# --- MODE B: CLOUDFLARE TUNNEL / TELEGRAM TESTING ---
# Set your active Cloudflare tunnels:
FRONTEND_URL=https://your-frontend-tunnel.trycloudflare.com
WEBAPP_URL=https://your-frontend-tunnel.trycloudflare.com
ALLOWED_ORIGINS=https://your-frontend-tunnel.trycloudflare.com,http://localhost:5173
VITE_BACKEND_URL=https://your-backend-tunnel.trycloudflare.com
