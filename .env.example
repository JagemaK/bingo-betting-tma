# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here
PORT=3001

# ==============================================================================
# Development Modes:
# ==============================================================================

# --- MODE A: LOCAL DEVELOPMENT ---
# FRONTEND_URL=http://localhost:5173
# WEBAPP_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# VITE_BACKEND_URL=http://localhost:3001

# --- MODE B: CLOUDFLARE TUNNEL / TELEGRAM TESTING ---
# Set your active Cloudflare tunnels:
FRONTEND_URL=https://your-frontend-tunnel.trycloudflare.com
WEBAPP_URL=https://your-frontend-tunnel.trycloudflare.com
ALLOWED_ORIGINS=https://your-frontend-tunnel.trycloudflare.com,http://localhost:5173
VITE_BACKEND_URL=https://your-backend-tunnel.trycloudflare.com
