{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://pts-lan-thomas-increased.trycloudflare.com/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://pts-lan-thomas-increased.trycloudflare.com/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
